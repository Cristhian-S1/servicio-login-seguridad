# Copia a .env y completa los secretos. NUNCA se commitea.
# POSTGRES_PASSWORD: solo para desarrollo local
POSTGRES_PASSWORD=dev_password_cambiala

# JWT_SECRET: minimo 32 caracteres. El valor de ejemplo es rechazado al arrancar.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_SECRET_WITH_openssl_rand_hex_32

# Opcionales (tienen default)
PORT=3000
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
ARGON_MEMORY_KIB=19456
ARGON_TIME=2
ARGON_PARALLELISM=1
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=900000

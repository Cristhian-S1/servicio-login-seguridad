# Copia a .env y completa el secreto. NUNCA se commitea.
# JWT_SECRET: minimo 32 caracteres. El valor de ejemplo es rechazado al arrancar.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_SECRET_WITH_openssl_rand_hex_32

# Opcionales (tienen default)
PORT=3000
DB_PATH=./data/login.db
ACCESS_TTL_MINUTES=15
ARGON_MEMORY_KIB=19456
ARGON_TIME=2
ARGON_PARALLELISM=1

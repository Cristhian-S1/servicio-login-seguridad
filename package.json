    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"

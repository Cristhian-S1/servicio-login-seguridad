{
  "name": "servicio-login",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de autenticacion: registro, JWT, refresh rotativo, MFA TOTP, RBAC",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",

{
  "name": "servicio-login",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de autenticacion: registro, JWT, refresh rotativo, MFA TOTP, RBAC",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/shared/db/migrations dist/src/shared/db/migrations && cp -r public/. dist/public/",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "vm:setup": "bash scripts/setup-vm.sh",
    "deploy": "bash scripts/deploy.sh",
    "ip:persist": "bash scripts/persist-ip.sh"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
